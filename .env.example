# ==============================================================================
# SPORTIVA CM 2.0 — Environment Configuration Template
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-sportiva-2026!
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database Settings (Default: SQLite for local development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Internationalization & Localization
DEFAULT_LANGUAGE=en
TIME_ZONE=UTC

# Email Configuration (Console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SPORTIVA <noreply@sportiva.global>

# Static & Media Storage
STATIC_URL=/static/
MEDIA_URL=/media/
